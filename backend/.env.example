# MongoDB 설정 (MongoDB Atlas에서 발급받은 URI 입력)
# 형식: mongodb+srv://<사용자명>:<비밀번호>@<클러스터주소>.mongodb.net/?appName=<앱이름>
# 예시 문자열을 그대로 두면 GitHub 시크릿 스캐닝이 실제 자격증명으로 오인하므로 값을 비워 둡니다.
MONGODB_URI=
DATABASE_NAME=youth_policy

# OpenAI API 설정 (https://platform.openai.com에서 발급)
OPENAI_API_KEY=sk-proj-YOUR_API_KEY_HERE

# 온통청년 API 설정 (선택)
YOUTHCENTER_API_KEY=

# 개발 환경 설정
DEBUG=True
LOG_LEVEL=INFO

# 서버 설정
HOST=0.0.0.0
PORT=8000

# 세션/토큰 서명용 시크릿 키
SECRET_KEY=

# 관리자 토큰 (POST /api/scheduler/refresh 수동 갱신용)
# 값을 넣으면 X-Admin-Token 헤더가 일치해야 갱신이 실행됩니다.
# 비워 두면 개발 환경에서는 기존처럼 동작하고, 운영(ENVIRONMENT=production)에서는 갱신이 차단됩니다.
ADMIN_REFRESH_TOKEN=
